{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/server/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --maxWorkers=3",
    "test:watch": "jest --watch --maxWorkers=3",
    "test:cov": "jest --coverage --maxWorkers=3",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/server/test/jest-e2e.json",
    "typeorm": "npx typeorm-ts-node-commonjs",
    "typeorm:identity:run": "npm run typeorm -- migration:run -d ./apps/identity/src/core/database/ormconfig.ts",
    "typeorm:identity:generate": "npm run typeorm -- migration:generate ./apps/identity/src/core/database/migrations/$npm_config_name -d ./apps/identity/src/core/database/ormconfig.ts",
    "typeorm:car:run": "npm run typeorm -- migration:run -d ./apps/car/src/core/database/ormconfig.ts",
    "typeorm:car:generate": "npm run typeorm -- migration:generate ./apps/car/src/core/database/migrations/$npm_config_name -d ./apps/car/src/core/database/ormconfig.ts",
    "typeorm:rental:run": "npm run typeorm -- migration:run -d ./apps/rental/src/core/database/ormconfig.ts",
    "typeorm:rental:generate": "npm run typeorm -- migration:generate ./apps/rental/src/core/database/migrations/$npm_config_name -d ./apps/rental/src/core/database/ormconfig.ts",
    "typeorm:file:run": "npm run typeorm -- migration:run -d ./apps/file/src/core/database/ormconfig.ts",
    "typeorm:file:generate": "npm run typeorm -- migration:generate ./apps/file/src/core/database/migrations/$npm_config_name -d ./apps/file/src/core/database/ormconfig.ts",
    "typeorm:run-migrations": "npm run typeorm -- migration:run -d ./src/core/database/ormconfig.ts",
    "typeorm:payment:run": "npm run typeorm -- migration:run -d ./apps/payment/src/core/database/ormconfig.ts",
    "typeorm:payment:generate": "npm run typeorm -- migration:generate ./apps/payment/src/core/database/migrations/$npm_config_name -d ./apps/payment/src/core/database/ormconfig.ts",
    "typeorm:generate-migration": "npm run typeorm -- migration:generate ./src/core/database/migrations/$npm_config_name -d ./src/core/database/ormconfig.ts",
    "typeorm:create-migration": "npm run typeorm -- migration:create ./src/core/database/migrations/$npm_config_name -d ./src/core/database/ormconfig.ts",
    "typeorm:revert-migration": "npm run typeorm -- migration:revert -d ./src/core/database/ormconfig.ts",
    "generate:spec": "npx ts-node --esm ./src/generate-spec.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.8.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^10.4.20",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/platform-socket.io": "^10.4.20",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.20",
    "@streamware/nestjs-pulsar": "^1.0.5",
    "@types/winston": "^2.4.4",
    "@vendia/serverless-express": "^4.12.6",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.9",
    "aws-lambda": "^1.0.7",
    "aws-sdk": "^2.1657.0",
    "aws-serverless-express": "^3.4.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.3.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ioredis": "^5.7.0",
    "joi": "^17.13.1",
    "kafkajs": "^2.2.4",
    "mqtt": "^5.14.1",
    "nats": "^2.29.3",
    "nodemailer": "^7.0.6",
    "opossum": "^9.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.12.0",
    "pulsar-client": "^1.14.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "streamifier": "^0.1.1",
    "stripe": "^18.5.0",
    "typeorm": "^0.3.26",
    "typeorm-naming-strategies": "^4.1.0",
    "winston": "^3.13.1",
    "winston-cloudwatch": "^6.3.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@golevelup/ts-jest": "^0.5.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.3.9",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/aws-lambda": "^8.10.140",
    "@types/aws-sdk": "^2.7.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.17",
    "@types/nodemailer": "^7.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "aws-sdk-mock": "^6.0.4",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.6.2",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^src/(.*)$": "<rootDir>/src/$1",
      "^@app/shared(|/.*)$": "<rootDir>/libs/shared/src/$1"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ]
  }
}
